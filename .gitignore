# Secrets — never commit
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build / output
dist/
out/
.wrangler/
coverage/
*.tsbuildinfo
.nova-build/
.nova-test-workdir/

# Local artifacts
*.log
.DS_Store
tmp/
.nova-test-workdir/

# Python (the Termux app)
__pycache__/
*.pyc

# Termux runtime state. Generated on the phone, never committed:
# saved places live in the SQLite DB, GPS cache and dialogue memory are
# per-device. data/catalog.json and data/knowledge/ ARE committed — they are
# inputs, not runtime state.
data/nova.db
data/nova.db-journal
data/nova.db-wal
data/nova.db-shm
data/gps/
data/memory/
data/logs/
data/places.json
data/config.json

# Release archives
*.zip

# local preview harness (esbuild output + SQLite state)
.preview/
